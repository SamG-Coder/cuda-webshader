{
  "name": "cuda-webshader",
  "version": "0.1.0",
  "private": true,
  "description": "A bounded CUDA C kernel to WGSL compiler, WebGPU compute runtime and Three.js GPU-resident demo.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:gpu": "node scripts/test-gpu.mjs",
    "compile": "node scripts/compile-all.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm test && npm run compile",
    "check:cuda-syntax": "node scripts/check-cuda-syntax.mjs",
    "bench:native:build": "powershell -NoProfile -File scripts/build-native.ps1",
    "bench:webgpu": "node scripts/run-comparison.mjs",
    "bench:report": "node scripts/report-comparison.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.52.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "license": "MIT"
}
